#!/usr/bin/env bash
# Top-level recovery entrypoint: checks Zed, OpenCode, and Firefox.
# Safe to run anytime - each tool knows when it has nothing to do.
set -uo pipefail

REAL="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$REAL")"

echo "===== Zed ====="
"$SCRIPT_DIR/zed-recover" || true

echo
echo "===== OpenCode ====="
"$SCRIPT_DIR/opencode-doctor" || true

echo
echo "===== Firefox ====="
"$SCRIPT_DIR/firefox-doctor" || true

echo
echo "===== Done ====="
echo "Commands available on PATH:"
echo "  blackboxd        - this all-in-one check"
echo "  zed-recover      - repair Zed + disk checks"
echo "  zed-doctor       - Zed-only repair"
echo "  opencode-doctor  - OpenCode health check"
echo "  opencode-safe    - OpenCode launcher with crash fallback"
echo "  firefox-doctor   - Firefox read-only profile diagnosis/repair"
